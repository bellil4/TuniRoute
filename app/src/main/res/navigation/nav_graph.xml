<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tuniroute.ui.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_results"
            app:destination="@id/resultsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/resultsFragment"
        android:name="com.tuniroute.ui.results.ResultsFragment"
        android:label="@string/title_results"
        tools:layout="@layout/fragment_results">

        <argument
            android:name="sourceName"
            app:argType="string"
            android:defaultValue="" />

        <argument
            android:name="destinationName"
            app:argType="string"
            android:defaultValue="" />

    </fragment>

</navigation>
